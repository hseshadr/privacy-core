# Copy to examples/demo/.env to call a real model through the dev proxy.
#
# OPENROUTER_API_KEY stays SERVER-SIDE: it is read only by the Vite dev proxy
# (vite.config.ts) and injected into the outbound request. It is never
# VITE_-prefixed, so it is NEVER exposed to the browser bundle.
OPENROUTER_API_KEY=
# Set to 1 to route the demo through OpenRouter (via the proxy). Unset/anything
# else runs the offline NoLLMProvider echo — the whole loop still works cold.
VITE_USE_OPENROUTER=
# Optional: override the model (default below is cheap + OpenAI-compatible).
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini
