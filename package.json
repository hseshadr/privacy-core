{
  "name": "@edgeproc/privacy-core",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "A browser-side structured-identifier redaction boundary for LLM calls: detects cards, IBANs, SSNs, emails, US phones and labeled account/routing numbers on-device, sends only placeholders, rehydrates locally — enforced by a type-checked Egress Guard. Names and free-text PII are not detected.",
  "keywords": [
    "pii",
    "pii-redaction",
    "pii-detection",
    "privacy",
    "data-masking",
    "llm",
    "llm-security",
    "prompt-privacy",
    "egress-control",
    "luhn",
    "iban",
    "browser",
    "client-side",
    "typescript",
    "gdpr"
  ],
  "license": "MIT",
  "author": "Harish Seshadri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hseshadr/privacy-core.git"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@edgeproc/avow": "^0.1.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p examples/demo/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "demo": "pnpm --filter @edgeproc/privacy-core-demo dev",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
